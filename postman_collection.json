            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman test görevi (güncellendi)\",\n  \"description\": \"PUT ile güncellendi\",\n  \"status\": \"in-progress\",\n  \"priority\": \"medium\",\n  \"assignee\": \"ayse\"\n}",
