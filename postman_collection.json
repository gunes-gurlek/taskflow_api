{
  "info": {
    "name": "TASKFLOW API",
    "description": "TASKFLOW Görev ve Proje Yönetim Sistemi REST API test koleksiyonu. \"CRUD (Zorunlu)\" klasörünü sırayla çalıştırın (Runner); taskId otomatik ayarlanır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "taskId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "CRUD (Zorunlu)",
      "item": [
        {
          "name": "1. Görev Ekle (POST /tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"success=true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test(\"id ve varsayılan status\", function () { const d = pm.response.json().data; pm.expect(d.id).to.be.a(\"number\"); pm.expect(d.status).to.eql(\"pending\"); });",
                  "pm.collectionVariables.set(\"taskId\", pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman test görevi\",\n  \"description\": \"Postman ile oluşturuldu\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Görevleri Listele (GET /tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"success=true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test(\"data bir dizi ve meta var\", function () { const j = pm.response.json(); pm.expect(j.data).to.be.an(\"array\"); pm.expect(j.meta.total).to.be.a(\"number\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          }
        },
        {
          "name": "3. Görev Detayı (GET /tasks/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"success=true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test(\"doğru görev döndü\", function () { pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get(\"taskId\"))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        },
        {
          "name": "4a. Görev Güncelle - tam (PUT /tasks/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"success=true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
                  "pm.test(\"güncellendi\", function () { const d = pm.response.json().data; pm.expect(d.status).to.eql(\"in-progress\"); pm.expect(d.assignee).to.eql(\"ayse\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
